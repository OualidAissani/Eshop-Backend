# ---------------------------------------------------------------------------
# Environment for the **Eshop** Dokploy service (the five .NET services).
# Paste the contents into that service's Environment tab.
# Never commit deploy/.env.
#
# Keycloak is a separate Dokploy service with its own variables: see
# DEPLOYMENT.md §7.3.
#
# Keep the quotes around values that contain & ? # or spaces.
# ---------------------------------------------------------------------------

# --- Public hostnames (no scheme, no trailing slash) ------------------------
# No domain? Replace 203.0.113.10 with your VPS public IPv4 and keep sslip.io.
# AUTH_DOMAIN is also used to reach Keycloak through Traefik.
API_DOMAIN=api.203.0.113.10.sslip.io
AUTH_DOMAIN=auth.203.0.113.10.sslip.io

# Exact browser origin allowed by the gateway (scheme included, no trailing slash)
FRONTEND_ORIGIN=https://maktabahislamiia.vercel.app

# --- PostgreSQL -----------------------------------------------------------------
# Paste ONE connection string, exactly like the one you used on Render.
# The compose file appends ";Search Path=<service>;Maximum Pool Size=10", and
# each service creates its own schema on startup. Nothing else to set up.
# Npgsql keywords: Host, Port, Database, Username, Password, SSL Mode.
# Supabase: session pooler host, port 5432, user "postgres.<project-ref>".
PG_CONNECTION='Host=aws-0-eu-central-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=change-me-postgres;SSL Mode=Require'

# --- Managed MongoDB (Atlas / ...) ------------------------------------------
# Atlas SRV URI. Keep the quotes: the string contains & and ?.
# The database name is the path segment before "?" (here /Eshop). Atlas creates
# it on first write. "appName=..." is only a label shown in Mongo's logs.
MONGO_CONNECTION='mongodb+srv://eshop:change-me@cluster0.xxxxx.mongodb.net/Eshop?retryWrites=true&w=majority&appName=Eshop'
# Optional override. Leave commented out to use the database from the URI.
# MONGO_DATABASE=Eshop

# --- Managed Redis (Upstash / Redis Cloud / ...) ----------------------------
# StackExchange.Redis key=value form. Keep the quotes.
# Upstash example: 'host.upstash.io:6379,password=change-me,ssl=True,abortConnect=False'
REDIS_CONNECTION='redis-host.example.com:6379,password=change-me,ssl=True,abortConnect=False'

# --- Managed RabbitMQ (CloudAMQP / ...) -------------------------------------
# Always include the port: 5671 for amqps, 5672 for plain amqp.
# The path is the virtual host ("/" is the default).
RABBITMQ_CONNECTION='amqps://eshop:change-me@host.cloudamqp.com:5671/vhost'

# --- UploadCare (Catalog service) -------------------------------------------
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=
UPLOADCARE_STORE=1
UPLOADCARE_BASE_URL=https://31a2bxztr3.ucarecd.net/

# --- Brevo / SMTP API (Notification service) --------------------------------
EMAIL_API_KEY=
EMAIL_BASE_URL=https://api.brevo.com/v3/
EMAIL_SENDER_NAME=Eshop
EMAIL_SENDER_EMAIL=no-reply@example.com

# --- Optional image tag (internal to the VPS) -------------------------------
TAG=latest
