# ---------------------------------------------------------------------------
# Copy this file to deploy/.env (or paste its contents into Dokploy's
# Environment tab) and replace every "change-me" value.
# Never commit deploy/.env.
#
# Keep the quotes around values that contain & ? # or spaces.
# ---------------------------------------------------------------------------

# --- Public hostnames (no scheme, no trailing slash) ------------------------
# No domain? Replace 203.0.113.10 with your VPS public IPv4 and keep sslip.io.
# sslip.io resolves the name to that IP and Traefik can obtain a free certificate.
API_DOMAIN=api.203.0.113.10.sslip.io
AUTH_DOMAIN=auth.203.0.113.10.sslip.io

# Exact browser origin allowed by the gateway (scheme included, no trailing slash)
FRONTEND_ORIGIN=https://maktabahislamiia.vercel.app

# --- Managed PostgreSQL (Neon / Supabase / RDS / ...) -----------------------
# Create these databases before deploying:
#   EshopCatalogDb, EshopInventoryDb, EshopOrderDb, keycloak
# Npgsql form used by the .NET services: Require | VerifyFull | VerifyCA | Disable
PG_SSL_MODE=Require
# JDBC form used by Keycloak: require | verify-full | verify-ca | disable
PG_JDBC_SSLMODE=require
PG_HOST=ep-cool-name-123456.eu-central-1.aws.neon.tech
PG_PORT=5432
PG_USER=eshop
PG_PASSWORD=change-me-postgres

CATALOG_DB=EshopCatalogDb
INVENTORY_DB=EshopInventoryDb
ORDER_DB=EshopOrderDb
KEYCLOAK_DB=keycloak

# Only needed if Keycloak uses a different user/password than the services.
# KEYCLOAK_DB_USER=eshop
# KEYCLOAK_DB_PASSWORD=change-me-postgres

# --- Managed MongoDB (Atlas / ...) ------------------------------------------
# Atlas SRV URI. Keep the quotes: the string contains & and ?.
MONGO_CONNECTION='mongodb+srv://eshop:change-me@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority'
MONGO_DATABASE=EshopCatalogDb

# --- Managed Redis (Upstash / Redis Cloud / ...) ----------------------------
# StackExchange.Redis key=value form. Keep the quotes.
# Upstash example: 'host.upstash.io:6379,password=change-me,ssl=True,abortConnect=False'
REDIS_CONNECTION='redis-host.example.com:6379,password=change-me,ssl=True,abortConnect=False'

# --- Managed RabbitMQ (CloudAMQP / ...) -------------------------------------
# Always include the port: 5671 for amqps, 5672 for plain amqp.
# The path is the virtual host ("/" is the default).
RABBITMQ_CONNECTION='amqps://eshop:change-me@host.cloudamqp.com:5671/vhost'

# --- Keycloak image ---------------------------------------------------------
# Built from your private Keycloak repo (Dockerfile + theme jar + realm
# export) and pushed to a registry. The VPS must be able to pull it; see
# DEPLOYMENT.md §8 for the registry login. Tag it with the Keycloak version.
KEYCLOAK_IMAGE=ghcr.io/oualidaissani/eshop-keycloak:26.8.1

# --- Keycloak (runs on the VPS, stores data in the managed PostgreSQL) ------
# Bootstrap admin, created only on the first start (change it after login).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# --- UploadCare (Catalog service) -------------------------------------------
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=
UPLOADCARE_STORE=1
UPLOADCARE_BASE_URL=https://31a2bxztr3.ucarecd.net/

# --- Brevo / SMTP API (Notification service) --------------------------------
EMAIL_API_KEY=
EMAIL_BASE_URL=https://api.brevo.com/v3/
EMAIL_SENDER_NAME=Eshop
EMAIL_SENDER_EMAIL=no-reply@example.com

# --- Optional image tag (internal to the VPS) -------------------------------
TAG=latest
